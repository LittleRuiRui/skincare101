{
  "name": "skincare-ai-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/expand-skin-concerns.mjs && vite",
    "build": "node scripts/expand-skin-concerns.mjs && vite build && node scripts/generate-seo-product-pages.mjs && node scripts/postbuild-seo-extras.mjs && node scripts/generate-blog.mjs",
    "build:app": "node scripts/expand-skin-concerns.mjs && vite build",
    "seo:generate": "node scripts/generate-seo-product-pages.mjs && node scripts/postbuild-seo-extras.mjs && node scripts/generate-blog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:seo": "node --test tests/product-selection.test.mjs tests/seo-output.test.mjs tests/blog-output.test.mjs tests/bilingual-output.test.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:catalog": "node scripts/catalog-governance-audit.mjs",
    "preview": "vite preview",
    "backup:sqlite": "python scripts/export_supabase_to_sqlite.py",
    "data:pilot": "python scripts/build_pilot_catalog.py",
    "data:pilot-sql": "python scripts/generate_pilot_sql.py",
    "data:enrichment-sql": "python scripts/generate_formula_enrichment_sql.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "^5.5.3",
    "vite": "8.2.1"
  }
}
